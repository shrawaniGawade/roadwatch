FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
COPY services/vision /workspace/services/vision
COPY requirements.lock /workspace/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock && pip install --no-cache-dir --no-deps /workspace/services/vision && useradd --create-home --uid 10001 vision
USER vision
EXPOSE 8001
CMD ["uvicorn", "roadwatch_vision.app:app", "--host", "0.0.0.0", "--port", "8001"]
